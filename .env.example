# Admin API base URL. REQUIRED — a production build now fails without it, rather
# than falling back to dev. A reviewer approving verification cases against the
# wrong environment is the worst failure this dashboard has.
NEXT_PUBLIC_ADMIN_API_URL=https://3tgjb2crdf.execute-api.af-south-1.amazonaws.com/admin

# Origin serving uploaded files. Required in every environment. Feeds the CSP
# (including frame-src, for the presigned KYC document preview) and next/image's
# remotePatterns. A wrong value renders document previews blank.
NEXT_PUBLIC_S3_ORIGIN=https://housinghub-files-dev.s3.af-south-1.amazonaws.com

# Route API calls through the Next.js proxy instead of calling the API directly.
# NEXT_PUBLIC_ENABLE_PROXY=true

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Use a SEPARATE Sentry project from the consumer app, so an outage here is
# distinguishable from one there. Leave unset and Sentry is inert.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# BUILD-TIME ONLY — source map upload. Never prefix with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
