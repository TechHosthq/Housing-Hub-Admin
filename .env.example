# Admin API base URL. Required in every environment.
NEXT_PUBLIC_ADMIN_API_URL=https://3tgjb2crdf.execute-api.af-south-1.amazonaws.com/admin

# Route API calls through the Next.js proxy instead of calling the API directly.
# NEXT_PUBLIC_ENABLE_PROXY=true

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Use a SEPARATE Sentry project from the consumer app, so an outage here is
# distinguishable from one there. Leave unset and Sentry is inert.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# BUILD-TIME ONLY — source map upload. Never prefix with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
